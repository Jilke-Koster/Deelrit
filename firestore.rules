rules_version = '2';
// Beveiligingsregels voor Deelrit.
// Plak dit in de Firebase-console bij Firestore Database → Regels, en klik op Publiceren.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMemberOf(carId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/cars/$(carId)).data.memberUids;
    }

    match /cars/{carId} {
      // Alleen leden zien een auto.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Wie een auto aanmaakt, is het eerste en enige lid.
      allow create: if signedIn()
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.name is string;

      // Leden mogen de auto aanpassen.
      // Wie de uitnodigingslink heeft (die het geheime auto-id bevat), mag alleen zichzelf toevoegen.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.memberUids
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.auth.uid in request.resource.data.memberUids
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() <= resource.data.members.size() + 1
        )
      );

      allow delete: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Ritten, tankbonnen en betalingen: alleen voor leden van de auto.
      match /entries/{entryId} {
        allow read, delete: if isMemberOf(carId);
        allow create, update: if isMemberOf(carId)
          && request.resource.data.type in ['trip', 'fuel'];
      }
    }
  }
}
